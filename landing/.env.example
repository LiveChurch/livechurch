# Copie para .env.local e preencha com a connection string do Postgres.
# Usada só no servidor (rota /api/leads); nunca vai para o navegador.
DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Bancos gerenciados (RDS etc.) exigem SSL e ele já vem ligado. Use false só em Postgres local sem SSL.
# DATABASE_SSL=false

# E-mail que envia o link de download; aparece na página de download (público, vai para o navegador).
NEXT_PUBLIC_SENDER_EMAIL=livechurch@gmail.com

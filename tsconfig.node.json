{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["electron/**/*.ts", "scripts/*.ts", "src/core/types/*.ts", "src/core/api/*.ts", "src/core/utils/StringUtils.ts", "src/core/utils/BroadcastWindowUtils.ts"]
}
